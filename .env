# Copia este archivo como ".env" y ajusta los valores.

# --- PostgreSQL local (el que ya tienes con pgAdmin) ---

# ---Crea una base de datos 

CREA UNA BASE DE DATSOS deteccion

#---Si tienes problemas con la conexion a la bd prueba esto (123 es un ejemplo que puse xD)

ALTER USER postgres WITH PASSWORD '123';

DB_HOST=localhost
DB_PORT=5432
DB_NAME=deteccion
DB_USER=postgres
DB_PASSWORD=123

# --- Fuente de video ---
# 0 = webcam principal, 1 = segunda cámara, o la ruta de un video (ej: pelea.mp4)
VIDEO_SOURCE=0

# --- Modelo ---
CONF=0.7
# Clase que significa "agresión" en tu modelo (en el código original era 1)
VIOLENCE_CLASS_ID=1

# --- Avisos ---
BEEP=true
# Opcional: WhatsApp con CallMeBot (déjalo vacío si no lo usas)
CALLMEBOT_PHONE=51965644988
CALLMEBOT_APIKEY=8648037   (call me bot)